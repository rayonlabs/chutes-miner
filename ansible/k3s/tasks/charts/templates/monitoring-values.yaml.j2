---
grafana:
  image:
    tag: "11.6.11"
    
  # Admin credentials
  adminUser: chutes
  adminPassword: "{{ grafana_password }}"

  service:
    type: NodePort
    nodePort: 30080

  plugins:
    - yesoreyeram-infinity-datasource

  # Data sources configuration
  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
        - name: Prometheus
          type: prometheus
          url: http://prometheus 
          access: proxy
          isDefault: true
        - orgId: 1
          uid: bez23gzeayku8d
          name: monitoring
          type: yesoreyeram-infinity-datasource
          typeName: Infinity
          typeLogoUrl: public/plugins/yesoreyeram-infinity-datasource/img/icon.svg
          access: proxy
          url: http://monitor.chutes.svc.cluster.local.:8000
          user: ''
          database: ''
          basicAuth: false
          isDefault: false
          jsonData:
            global_queries: []
          readOnly: false

  # Enable sidecar for dashboard discovery
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      searchNamespace: ALL

  # Configure Grafana dashboard providers
  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
        - name: default
          orgId: 1
          folder: ''
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/default

  dashboardsConfigMaps:
    default: grafana-dashboards
  
prometheus:
  fullnameOverride: prometheus
  
  server:
    fullnameOverride: prometheus-server
    service:
      type: ClusterIP
    extraConfigmapMounts:
      - name: prometheus-scrape-configs
        mountPath: /etc/prometheus/custom_scrape_configs
        configMap: prometheus-scrape-configs

  scrapeConfigFiles:
    - /etc/prometheus/custom_scrape_configs/federation.yaml

  federation:
    enabled: true
    scrapeInterval: '15s'
    matchSelectors:
    - '{job="kubernetes-pods"}'
    - '{job="kubernetes-nodes-cadvisor"}'
    - '{job="node-exporter"}'
    clusters:
{# Federate from every GPU worker plus any TEE servers. TEE hosts live in a
   separate inventory (managed by a different repo) and are not provisioned by
   this playbook, so they are kept in their own `tee_workers` group and only
   merged in for the monitoring deploy. #}
{% for host in (groups['workers'] | default([])) + (groups['tee_workers'] | default([])) %}
{# Resolve the externally-reachable IP. Regular workers get `public_ip` set as a
   fact during site.yml; TEE hosts are not in that play, so fall back to
   external_ip / ansible_host straight from inventory. For a TEE server this is
   the *host* IP, whose bridge DNATs the NodePort range (30000-32767, incl.
   Prometheus 30090) through to the VM. #}
{%   set fed_ip = hostvars[host]['public_ip'] | default(hostvars[host]['external_ip'] | default(hostvars[host]['ansible_host'])) %}
{%   set fed_port = hostvars[host]['federation_port'] | default(30090) %}
    - endpoint: {{ fed_ip }}:{{ fed_port }}
      name: {{ host }}
{% endfor %}
